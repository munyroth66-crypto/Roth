  <style>
    :root {
      --cream: #fbf6ee;
      --paper: #fffdf9;
      --gold: #b08a52;
      --gold-light: #d9c6a5;
      --brown: #4b4037;
      --soft: #75685c;
      --white: #ffffff;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background: var(--cream);
      color: var(--brown);
      font-family: "Noto Serif Khmer", serif;
      line-height: 1.9;
    }

    section {
      padding: 70px 20px;
    }

    .container {
      width: 100%;
      max-width: 760px;
      margin: auto;
    }

    /* COVER */

    .cover {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      position: relative;
      overflow: hidden;
      background:
        radial-gradient(circle at top left,
          rgba(176,138,82,.12),
          transparent 35%),
        radial-gradient(circle at bottom right,
          rgba(176,138,82,.10),
          transparent 35%),
        var(--cream);
    }

    .cover::before,
    .cover::after {
      content: "";
      position: absolute;
      width: 180px;
      height: 180px;
      border: 1px solid var(--gold-light);
      border-radius: 50%;
      opacity: .5;
    }

    .cover::before {
      top: -90px;
      left: -90px;
    }

    .cover::after {
      bottom: -90px;
      right: -90px;
    }

    .cover-content {
      position: relative;
      z-index: 2;
      animation: fadeUp 1.2s ease;
    }

    .small-title {
      font-size: 15px;
      letter-spacing: 2px;
      color: var(--gold);
      margin-bottom: 12px;
    }

    .english {
      font-family: "Playfair Display", serif;
      font-size: 17px;
      letter-spacing: 3px;
      color: var(--soft);
      margin-bottom: 35px;
    }

    .names {
      font-size: 38px;
      font-weight: 600;
      color: var(--brown);
    }

    .heart {
      color: var(--gold);
      font-size: 30px;
      margin: 8px 0;
    }

    .names-en {
      font-family: "Playfair Display", serif;
      font-size: 20px;
      letter-spacing: 1px;
      color: var(--soft);
      margin-top: 8px;

    /* COPY LINK */

    function copyLink() {

      navigator.clipboard.writeText(window.location.href)
        .then(() => {

          alert("បានចម្លងតំណភ្ជាប់រួចរាល់ ❤️");

        })
        .catch(() => {

          alert("សូមចម្លងតំណភ្ជាប់ពី Browser។");

        });

    }



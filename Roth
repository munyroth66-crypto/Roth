      const shareData = {
        title: "មុន្នីរ័ត្ន ♥ វឌ្ឍនៈ",
        text: "សូមចូលរួមក្នុងពិធីមង្គលការរបស់ មុន្នីរ័ត្ន & វឌ្ឍនៈ ❤️",
        url: window.location.href
      };

      if (navigator.share) {

        navigator.share(shareData);

      } else {

        copyLink();

      }

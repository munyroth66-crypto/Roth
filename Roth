    .date {
      font-size: 24px;
      font-weight: 600;
      color: var(--gold);
    }

    .date-en {
      font-family: "Playfair Display", serif;
      font-size: 17px;
      margin-top: 5px;
      color: var(--soft);
    }

    .location-mini {
      font-size: 14px;
      margin-top: 20px;
      color: var(--soft);
    }

    .scroll {
      position: absolute;
      bottom: 25px;
      left: 50%;
      transform: translateX(-50%);
      font-size: 13px;
      color: var(--gold);
      animation: bounce 2s infinite;
    }

    /* SECTIONS */

    .section {
      background: var(--paper);
      margin: 18px auto;
      border-radius: 28px;
      box-shadow: 0 10px 40px rgba(70, 50, 30, .05);
